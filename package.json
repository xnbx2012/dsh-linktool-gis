{
  "name": "@linktool/dsh-plugin",
  "version": "3.1.0",
  "type": "module",
  "description": "LinkTool GIS plugin for DeepSeek Harness",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "resources",
    "config",
    "cordis.patch.yml",
    "README.md",
    "MIGRATION.md",
    "scripts",
    "src",
    "client",
    "tsconfig.json",
    "package-lock.json",
    "resources-full.tar.gz",
    "install.ps1"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "install:plugin": "node scripts/install.mjs",
    "release": "node scripts/release.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepack": "node scripts/archive-resources.mjs",
    "check:mcp": "node scripts/check-mcp.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "esbuild": "^0.25.0",
    "yaml": "^2.8.0",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
