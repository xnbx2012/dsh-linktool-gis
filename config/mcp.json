{
  "amap-maps": {
    "args": [
      "-y",
      "@amap/amap-maps-mcp-server"
    ],
    "command": "npx",
    "env": {
      "AMAP_MAPS_API_KEY": "${AMAP_MAPS_API_KEY}"
    }
  },
  "arcgis-mcp-server": {
    "args": [
      "run",
      "--with",
      "mcp[cli]>=1.26,<2",
      "python",
      "${DSH_PLUGIN_ROOT}/scripts/arcgis-mcp-server/main.py"
    ],
    "command": "uv"
  },
  "bing-search": {
    "args": [
      "-y",
      "bing-cn-mcp"
    ],
    "command": "npx"
  },
  "color-style": {
    "args": [
      "run",
      "--with",
      "mcp[cli]>=1.26,<2",
      "python",
      "${DSH_PLUGIN_ROOT}/scripts/color-style-mcp/color_style_server.py"
    ],
    "command": "uv",
    "cwd": "${DSH_PLUGIN_ROOT}/scripts/color-style-mcp"
  },
  "knowledge-db": {
    "args": [],
    "command": "${DSH_PLUGIN_ROOT}/scripts/knowledge-db-mcp/run.bat",
    "env": {
      "SILICONFLOW_API_KEY": "${SILICONFLOW_API_KEY}"
    }
  },
  "memory-server": {
    "headers": {
      "X-Auth-Password": "${LINKTOOL_MEMORY_PASSWORD}",
      "X-Auth-Username": "${LINKTOOL_MEMORY_USERNAME}"
    },
    "type": "streamable-http",
    "url": "${LINKTOOL_MEMORY_URL}"
  },
  "pdf-reader-mcp": {
    "args": [
      "run",
      "--with",
      "mcp[cli]>=1.26,<2",
      "--with",
      "pymupdf",
      "python",
      "${DSH_PLUGIN_ROOT}/scripts/pdf-reader-mcp/main.py"
    ],
    "command": "uv"
  },
  "MiniMax": {
    "command": "uvx",
    "args": [
      "minimax-coding-plan-mcp",
      "-y"
    ],
    "env": {
      "MINIMAX_API_KEY": "${MINIMAX_API_KEY}",
      "MINIMAX_API_HOST": "${MINIMAX_API_HOST}"
    }
  }
}
