      "path": "skills/report-generate/SKILL.md",
      "metadata": {
        "name": "report-generate",
        "description": "根据用户提供的GIS数据生成符合国家规范的报告文档（docx格式）。支持耕地质量评价、三普、三调等报告类型。",
        "allowed-tools": "arcgis-mcp-server, Docx-Mcp_Server, bing-search, knowledge-db",
        "parameters": [
          {
            "name": "data_path",
            "description": "GIS数据源路径（GDB/SHP文件）或评价结果CSV文件",
            "required": true
          },
          {
            "name": "report_type",
            "description": "报告类型：\"耕地质量评价\"/\"三普\"/\"三调\"。默认自动识别",
            "required": false
          },
          {
            "name": "output_path",
            "description": "输出报告路径，默认\"test/03_Result/生成报告.docx\"",
            "required": false
          },
          {
            "name": "county_name",
            "description": "县/镇名称，用于报告中地理描述",
            "required": false
          },
          {
            "name": "weights_config",
            "description": "自定义评价指标权重配置（JSON格式）。不填则使用华南区默认值。格式：{\"水资源条件\": 0.0851, \"排水能力\": 0.0760, ...}",
            "required": false
          },
          {
            "name": "region_type",
            "description": "区域类型：华南区/华北区/东北区/西南区/西北区。默认\"华南区\"",
            "required": false
          }
        ]
      },
